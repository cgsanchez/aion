#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
conda_root="${AION_CONDA_ROOT:-/home/cgs/01_TOOLS/EasyBuild/conda}"
conda_prefix="${AION_CONDA_PREFIX:-$conda_root/envs/aion}"
python_bin="$conda_prefix/bin/python"

if [[ ! -x "$python_bin" ]]; then
    echo "missing declared Aion Conda Python: $python_bin" >&2
    exit 127
fi

export CUPY_CACHE_DIR="${CUPY_CACHE_DIR:-/tmp/aion-cupy-cache}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/aion-cache}"
export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"
export AION_GPU_LAUNCHER=1

python_site="$("$python_bin" -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
nvidia_lib_root="$python_site/nvidia"
if [[ -d "$nvidia_lib_root" ]]; then
    for libdir in "$nvidia_lib_root"/*/lib; do
        if [[ -d "$libdir" ]]; then
            export LD_LIBRARY_PATH="$libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        fi
    done
    cusolver_lib="$nvidia_lib_root/cusolver/lib/libcusolver.so.11"
    if [[ -f "$cusolver_lib" ]]; then
        export LD_PRELOAD="$cusolver_lib${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
fi

cd "$repo_root"
exec "$python_bin" "$@"
